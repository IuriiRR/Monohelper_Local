# API key for internal endpoint authentication
INTERNAL_API_KEY=replace-me

# Timezone used for monthly report calculations
REPORT_TIMEZONE=Europe/Kyiv

# SQLite database path (default: secrets/cloudapi_local.db)
# DB_PATH=secrets/cloudapi_local.db

# --- Logging (server + worker) ---
# LOG_LEVEL=INFO

# --- Background worker ---
# Idle poll interval when the queue is empty (seconds)
# WORKER_POLL_INTERVAL=2
# Backoff between retries — matches Monobank's 1-minute cooldown (seconds)
# WORKER_RETRY_BACKOFF_SEC=60
# Max handler attempts before a task is dead-lettered
# WORKER_MAX_ATTEMPTS=15
# Hard per-task time budget before dead-lettering (seconds, default 15 min)
# WORKER_TASK_DEADLINE_SEC=900

# --- Scheduled daily sync ---
# Omit or leave blank to disable. Times are local in SCHEDULE_TZ.
# SCHEDULE_ACCOUNTS_TIME=22:00
# SCHEDULE_TRANSACTIONS_TIME=23:00
# SCHEDULE_TZ=Europe/Kyiv
